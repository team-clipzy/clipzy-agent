# =============================================
# Application
# =============================================
APP_NAME=clipzy-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# =============================================
# OpenAI
# =============================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# =============================================
# YouTube Data API
# =============================================
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxx

# =============================================
# Qdrant
# =============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_VIDEO=clipzy_videos
QDRANT_COLLECTION_USER=clipzy_users

# =============================================
# MySQL (Spring 서버와 공유)
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clipzy
DB_USER=root
DB_PASSWORD=your_password_here

# =============================================
# Redis
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================
# JWT (Spring 서버와 동일한 Secret 사용 필수)
# =============================================
JWT_SECRET=your_jwt_secret_here_must_match_spring
JWT_ALGORITHM=HS256

# =============================================
# Spring Server
# =============================================
SPRING_SERVER_URL=http://localhost:8080
INTERNAL_API_KEY=internal_key_for_spring_communication